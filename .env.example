# EconPulse pipeline keys
#
# Only a maintainer needs these, and only to rebuild the database. Anyone who
# just runs the app reads the prebuilt SQLite file and needs no keys at all.
#
# That distinction is the whole point. Getting a Census key takes minutes, but
# ten minutes is ten minutes, and nobody should have to spend it to look up
# their own town.

# Required to rebuild. https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Required to rebuild output and federal money.
# https://apps.bea.gov/API/signup/
BEA_API_KEY=
# https://www.usaspending.gov — no key needed, listed for completeness

# Optional. Raises the BLS rate limit from 25 queries a day.
# https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Where the build writes the file. Defaults to ./data/econpulse.db
# ECONPULSE_DB=
