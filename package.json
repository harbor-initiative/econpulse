{
  "name": "econpulse",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Open, offline, citable data on how American places are doing.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "load": "tsx pipeline/build.ts",
    "verify": "tsx pipeline/verify.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "serve": "tsx server/index.ts",
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/mcp.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsx": "^4.21.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "econpulse-mcp": "server/mcp.ts"
  }
